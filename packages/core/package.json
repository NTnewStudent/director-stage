{
  "name": "@director-stage/core",
  "version": "1.0.0",
  "description": "3D director stage React component for AI video models (Seedance, Kling, Omni, H3): stage characters, props and cameras, then export stills, preview clips and camera-language prompts.",
  "keywords": [
    "react",
    "three",
    "react-three-fiber",
    "3d",
    "director",
    "storyboard",
    "camera",
    "cinematography",
    "seedance",
    "kling",
    "ai-video"
  ],
  "license": "MIT",
  "homepage": "https://github.com/NTnewStudent/director-stage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NTnewStudent/director-stage.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/NTnewStudent/director-stage/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "dev": "vitest",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": "^0.185.1"
  },
  "dependencies": {
    "i18next": "^23.16.8",
    "lucide-react": "^1.11.0",
    "react-i18next": "^14.1.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^27.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "0.185.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.0.7"
  }
}
